<div class="min-h-screen bg-white flex flex-col">
  <div class="w-full py-6 bg-green-50 text-center">
    <h1 class="text-2xl font-bold text-gray-800">ありがとう貯金</h1>
  </div>

  <div class="w-full py-4 bg-white border-b">
    <div class="max-w-7xl mx-auto px-4 flex justify-center gap-4">
      <%= link_to "記録一覧", thanks_path, class: "px-6 py-2 rounded-full bg-green-400 text-white hover:bg-green-500" %>
      <%= link_to "マイページ", edit_user_registration_path, class: "px-6 py-2 rounded-full bg-green-400 text-white hover:bg-green-500" %>
      <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-6 py-2 rounded-full bg-green-400 text-white hover:bg-green-500" %>
    </div>
  </div>

  <div class="flex-1 px-4 py-8">
    <div class="max-w-md mx-auto">
      <h2 class="text-2xl font-bold text-gray-800 text-center mb-8">マイページ</h2>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- メールアドレス変更フォーム -->
      <div class="mb-8 bg-gray-50 rounded-lg p-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">メールアドレス変更</h3>
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
          <div class="mb-4">
            <%= f.label :email, "新しいメールアドレス", class: "block text-gray-700 font-medium mb-2" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400" %>
          </div>

          <div class="mb-6">
            <%= f.label :current_password, "現在のパスワード（確認用）", class: "block text-gray-700 font-medium mb-2" %>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400" %>
          </div>

          <%= f.submit "メールアドレスを変更", class: "w-full px-6 py-3 bg-green-400 text-white rounded-full hover:bg-green-500 cursor-pointer" %>
        <% end %>
      </div>

      <!-- パスワード変更フォーム -->
      <div class="mb-8 bg-gray-50 rounded-lg p-6">
        <h3 class="text-lg font-bold text-gray-800 mb-4">パスワード変更</h3>
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
          <div class="mb-4">
            <%= f.label :current_password, "現在のパスワード", class: "block text-gray-700 font-medium mb-2" %>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400" %>
          </div>

          <div class="mb-4">
            <%= f.label :password, "新しいパスワード", class: "block text-gray-700 font-medium mb-2" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400" %>
          </div>

          <div class="mb-6">
            <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "block text-gray-700 font-medium mb-2" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400" %>
          </div>

          <%= f.submit "パスワードを変更", class: "w-full px-6 py-3 bg-green-400 text-white rounded-full hover:bg-green-500 cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="w-full text-center py-6 text-gray-400 text-sm bg-green-50">
    © 2026 ありがとう貯金
  </div>
</div>