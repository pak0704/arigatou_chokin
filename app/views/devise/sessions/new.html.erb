<div class="min-h-screen bg-white flex flex-col">
  <div class="w-full py-6 text-center bg-green-50">
    <h1 class="text-2xl font-bold text-gray-800">ありがとう貯金</h1>
  </div>

  <div class="flex-1 flex items-center justify-center px-4">
    <div class="w-full max-w-md">
      <h2 class="text-2xl font-bold text-gray-800 text-center mb-8">ログイン</h2>

      <% if alert.present? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
          <%= alert %>
        </div>
      <% end %>
      <% if notice.present? %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6">
          <%= notice %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="mb-6">
          <%= f.label :email, "メールアドレス", class: "block text-gray-700 font-medium mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400" %>
        </div>

        <div class="mb-8">
          <%= f.label :password, "パスワード", class: "block text-gray-700 font-medium mb-2" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400" %>
        </div>

        <div class="mb-6">
          <%= f.submit "ログイン", class: "w-full px-6 py-3 bg-green-400 text-white rounded-full font-medium hover:bg-green-500 transition cursor-pointer" %>
        </div>
      <% end %>

      <div class="text-center space-y-3">
        <%= link_to "パスワードを忘れた方はこちら", new_password_path(resource_name), class: "block text-green-600 hover:text-green-700" %>
        <%= link_to "新規登録はこちら", new_registration_path(resource_name), class: "block text-green-600 hover:text-green-700" %>
      </div>
    </div>
  </div>

  <div class="w-full text-center py-6 text-gray-400 text-sm bg-green-50">
    © 2026 ありがとう貯金
  </div>
</div>