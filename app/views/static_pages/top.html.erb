<div class="text-center mt-20">
  <h1 class="text-4xl font-bold text-gray-800">ありがとう貯金</h1>
  <p class="text-xl mt-4 text-gray-600">日常の感謝を記録するアプリ</p>

  <div class="mt-8 space-x-4">
    <% if user_signed_in? %>
      <%= link_to "記録を見る", thanks_path, class: "bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-8 rounded inline-block" %>
      <%= link_to "新規作成", new_thank_path, class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-8 rounded inline-block" %>
      <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "bg-gray-500 hover:bg-gray-600 text-white font-bold py-3 px-8 rounded inline-block" %>
    <% else %>
      <%= link_to "新規登録", new_user_registration_path, class: "bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-8 rounded inline-block" %>
      <%= link_to "ログイン", new_user_session_path, class: "bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-8 rounded inline-block" %>
    <% end %>
  </div>
</div>