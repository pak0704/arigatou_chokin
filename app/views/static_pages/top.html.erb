<% if user_signed_in? %>
  <!-- ログイン後の表示 -->
  <div class="min-h-screen bg-white flex flex-col">
    <div class="w-full py-6 bg-green-50 text-center">
      <h1 class="text-2xl font-bold text-gray-800">ありがとう貯金</h1>
    </div>

    <div class="w-full py-4 bg-white border-b">
      <div class="max-w-7xl mx-auto px-4 flex justify-center gap-4">
        <%= link_to "記録一覧", thanks_path, class: "px-6 py-2 rounded-full bg-green-400 text-white hover:bg-green-500" %>
        <%= link_to "マイページ", edit_user_registration_path, class: "px-6 py-2 rounded-full bg-green-400 text-white hover:bg-green-500" %>
        <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-6 py-2 rounded-full bg-green-400 text-white hover:bg-green-500" %>
      </div>
    </div>

    <div class="flex-1 flex items-center justify-center px-4 py-16">
      <div class="text-center max-w-xl">
        <h2 class="text-2xl font-bold text-gray-800 mb-8">今日の思い出</h2>

        <% if @random_thank %>
          <div class="bg-gray-50 rounded-lg p-8 mb-6">
            <p class="text-gray-600 mb-4"><%= @random_thank.date.strftime("%Y年%m月%d日") %></p>
            <p class="text-gray-700 mb-2"><%= @random_thank.from_who %>から</p>
            <p class="text-gray-700">「<%= @random_thank.situation %>」</p>
          </div>

          <div class="mb-8">
            <%= link_to "前回の記録を見る", thanks_path, class: "text-green-600 hover:text-green-700" %>
          </div>
        <% else %>
          <div class="bg-gray-50 rounded-lg p-8 mb-8">
            <p class="text-gray-600">まだ記録がありません</p>
          </div>
        <% end %>

        <%= link_to "新規作成を開始", new_thank_path, class: "inline-block px-12 py-3 bg-green-400 text-white rounded-full hover:bg-green-500" %>
      </div>
    </div>

    <div class="w-full text-center py-6 text-gray-400 text-sm bg-green-50">
      © 2026 ありがとう貯金
    </div>
  </div>
<% else %>
  <!-- 未ログイン時の表示 -->
  <div class="min-h-screen bg-white flex flex-col">
    <div class="w-full py-6 text-center bg-green-50">
      <h1 class="text-2xl font-bold text-gray-800">ありがとう貯金</h1>
    </div>

    <div class="flex-1 flex items-center justify-center px-4 py-16">
      <div class="text-center max-w-xl">
        <div class="space-x-4 mb-12">
          <%= link_to "ログイン", new_user_session_path, class: "inline-block px-8 py-2.5 rounded-full bg-green-400 text-white hover:bg-green-500" %>
          <%= link_to "新規登録", new_user_registration_path, class: "inline-block px-8 py-2.5 rounded-full border border-green-300 bg-white text-green-600 hover:bg-green-50" %>
        </div>

        <h2 class="text-3xl font-bold text-gray-800 mb-8 leading-relaxed">
          ありがとう...<br>
          それは、未来のあなたを励ます言葉
        </h2>

        <p class="text-gray-700 mb-12 leading-relaxed">
          日常で出会ったありがとうを記録し<br>
          未来の自分の糧にしよう。
        </p>

        <%= link_to "今すぐ始める", new_user_registration_path, class: "inline-block px-12 py-3 bg-green-400 text-white rounded-full hover:bg-green-500" %>
      </div>
    </div>

    <div class="w-full text-center py-6 text-gray-400 text-sm bg-green-50">
      © 2026 ありがとう貯金
    </div>
  </div>
<% end %>