<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">ありがとう記録一覧</h1>
    <%= link_to "新規作成", new_thank_path, class: "bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-6 rounded" %>
  </div>

  <% if @thanks.any? %>
    <div class="space-y-4">
      <% @thanks.each do |thank| %>
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex justify-between items-start mb-3">
            <div>
              <p class="text-sm text-gray-500"><%= thank.date %></p>
              <h2 class="text-xl font-bold text-gray-800 mt-1"><%= thank.from_who %></h2>
            </div>
          </div>
          
          <div class="mb-3">
            <h3 class="text-sm font-semibold text-gray-600 mb-1">どんな状況で</h3>
            <p class="text-gray-700"><%= simple_format(thank.situation) %></p>
          </div>

          <% if thank.feeling.present? %>
            <div>
              <h3 class="text-sm font-semibold text-gray-600 mb-1">どう感じたか</h3>
              <p class="text-gray-700"><%= simple_format(thank.feeling) %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-gray-500 text-lg mb-4">まだありがとう記録がありません</p>
      <%= link_to "最初の記録を作成する", new_thank_path, class: "bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-6 rounded inline-block" %>
    </div>
  <% end %>
</div>