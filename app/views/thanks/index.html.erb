<div class="min-h-screen bg-white flex flex-col">
  <div class="w-full py-6 bg-green-50 text-center">
    <h1 class="text-2xl font-bold text-gray-800">ありがとう貯金</h1>
  </div>

  <div class="w-full py-4 bg-white border-b">
    <div class="max-w-7xl mx-auto px-4 flex justify-center gap-4">
      <%= link_to "記録一覧", thanks_path, class: "px-6 py-2 rounded-full bg-green-400 text-white hover:bg-green-500" %>
      <%= link_to "マイページ", edit_user_registration_path, class: "px-6 py-2 rounded-full bg-green-400 text-white hover:bg-green-500" %>
      <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-6 py-2 rounded-full bg-green-400 text-white hover:bg-green-500" %>
    </div>
  </div>

  <div class="flex-1 px-4 py-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-800 text-center mb-8">記録一覧</h2>

      <div class="bg-gray-50 rounded-lg p-6 mb-6">
        <h3 class="text-lg font-semibold mb-4">日付範囲</h3>
        <%= form_with url: thanks_path, method: :get, local: true do |f| %>
          <div class="flex gap-4 mb-4 items-center">
            <%= f.date_field :from_date, value: params[:from_date], class: "px-4 py-2 border border-gray-300 rounded-lg" %>
            <span>〜</span>
            <%= f.date_field :to_date, value: params[:to_date], class: "px-4 py-2 border border-gray-300 rounded-lg" %>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-semibold mb-2">キーワード</h3>
            <%= f.text_field :situation, value: params[:situation], placeholder: "キーワードを入力", class: "w-full px-4 py-2 border border-gray-300 rounded-lg" %>
          </div>

          <div class="text-center">
            <%= f.submit "検索", class: "px-12 py-3 bg-green-400 text-white rounded-full hover:bg-green-500 cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <% if @thanks.any? %>
        <div class="space-y-4 mb-8">
          <% @thanks.each do |thank| %>
            <div class="bg-gray-50 rounded-lg p-6">
              <p class="text-gray-600 mb-2"><%= thank.date.strftime('%Y年%m月%d日') %></p>
              <p class="font-semibold mb-2"><%= thank.from_who %>から</p>
              <p class="text-gray-700 mb-4">「<%= truncate(thank.situation, length: 50) %>」</p>
              <%= link_to '詳細を見る', thank_path(thank), class: 'text-green-600 hover:text-green-700' %>
            </div>
          <% end %>
        </div>
        <div class="mb-8 flex justify-center">
          <%= paginate @thanks %>
        </div>
      <% else %>
        <p class="text-gray-600 text-center mb-8">検索条件に一致する記録がありません。</p>
      <% end %>

      <div class="text-center">
        <%= link_to '新規記録を作成', new_thank_path, class: 'inline-block px-12 py-3 bg-green-400 text-white rounded-full hover:bg-green-500' %>
      </div>
    </div>
  </div>

  <div class="w-full text-center py-6 text-gray-400 text-sm bg-green-50">
    © 2026 ありがとう貯金
  </div>
</div>